# Copy this to .env and configure for your environment

# ============ DATABASE ============
DATABASE_URL=postgresql://pulsewatch:pulsewatch_dev@db:5432/pulsewatch
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============ API ============
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=True

# ============ SECURITY ============
# IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-change-in-prod-min-32-chars
API_KEY_HEADER=X-API-Key
API_KEY=pulsewatch_dev_key_change_in_prod

# ============ CORS ============
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://frontend:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-API-Key","Accept","Origin"]

# ============ ML / ANOMALY DETECTION ============
# Detection method: isolation_forest, z_score, or hybrid
ANOMALY_DETECTION_METHOD=isolation_forest

# Z-Score threshold (standard deviations)
Z_SCORE_THRESHOLD=3.0

# IsolationForest contamination rate (expected anomaly %)
ISOLATION_FOREST_CONTAMINATION=0.1

# Minimum samples required before detection is active
MIN_SAMPLES_FOR_DETECTION=50

# Confidence threshold for evaluation
EVAL_THRESHOLD_CONFIDENCE=0.5

# ============ MONITORING ============
LOG_LEVEL=INFO
METRICS_RETENTION_DAYS=30
ANOMALY_AGGREGATION_WINDOW_MINUTES=5
RECOVERY_CONFIRMATION_MINUTES=5

# ============ REDIS (Optional) ============
REDIS_URL=redis://redis:6379/0
USE_REDIS=false

# ============ WEBSOCKET ============
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# ============ FRONTEND ============
VITE_API_URL=http://localhost:8000
VITE_API_KEY=pulsewatch_dev_key_change_in_prod

# ============ NOTIFICATIONS ============
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alerts@pulsewatch.local
SMTP_TO_EMAIL=admin@pulsewatch.local
WEBHOOK_URL=
